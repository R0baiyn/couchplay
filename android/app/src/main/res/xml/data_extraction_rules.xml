<?xml version="1.0" encoding="utf-8"?>
<!-- Rien ne part dans une sauvegarde ni vers un nouvel appareil : depuis
     Android 12, allowBackup="false" n'empêche plus le transfert d'un appareil
     à l'autre. Les comptes, chiffrés par une clé propre à l'appareil, ne
     s'y reliraient pas. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="device_root" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="device_root" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
