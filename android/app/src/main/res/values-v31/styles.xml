<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : le système dessine lui-même l'écran de démarrage à partir
         du thème. Fond = celui de l'app (surface sombre du thème, 0xFF151218),
         icône = celle de l'app. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#151218</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
